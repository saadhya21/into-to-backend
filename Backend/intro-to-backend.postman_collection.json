{
  "info": {
    "_postman_id": "c1f7b8a2-89e4-4a21-9988-6623bc1a9b20",
    "name": "Intro to Backend Tutorial API",
    "description": "Postman collection for testing the Intro to Backend tutorial APIs (User Auth & Posts CRUD) built with Node.js, Express, and MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "REPLACE_WITH_ACTUAL_POST_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Check if backend server is online and running"
      },
      "response": []
    },
    {
      "name": "Users / Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "register"
              ]
            },
            "description": "Registers a new user and hashes password with bcrypt"
          },
          "response": []
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "login"
              ]
            },
            "description": "Authenticates user by validating hashed password"
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "logout"
              ]
            },
            "description": "Logs out user"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Posts (CRUD Operations)",
      "item": [
        {
          "name": "Create Post (C in CRUD)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Backend Post\",\n  \"content\": \"This is the post content created via Postman to test our Node.js & Express API!\",\n  \"author\": \"testuser\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "description": "Creates a new post document in MongoDB"
          },
          "response": []
        },
        {
          "name": "Get All Posts (R in CRUD)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "description": "Fetches all posts from MongoDB sorted by newest first"
          },
          "response": []
        },
        {
          "name": "Get Single Post by ID (R in CRUD)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Fetches a specific post using its MongoDB ObjectId"
          },
          "response": []
        },
        {
          "name": "Update Post by ID (U in CRUD)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Post Title via Postman\",\n  \"content\": \"This content has been updated successfully using HTTP PUT!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Updates fields of an existing post using its ID"
          },
          "response": []
        },
        {
          "name": "Delete Post by ID (D in CRUD)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Deletes a post from MongoDB by its ID"
          },
          "response": []
        }
      ]
    }
  ]
}
